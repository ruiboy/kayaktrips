SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Cloudflare — scoped token: Workers Scripts, D1, R2 (Edit); Account Settings (Read)
CLOUDFLARE_API_TOKEN=your-scoped-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Temporary, migration only — bypasses all RLS. Rotate once the data copy is done.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Access
NUXT_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
NUXT_ACCESS_AUD=access-application-aud-tag
# Dev only — stands in for an Access login under `nuxt dev`, ignored in a build
NUXT_DEV_EDITOR_EMAIL=you@example.com
